  document.getElementById('stat-doanhthu').textContent=fmt(tongDT);
  document.getElementById('stat-ban').textContent=`${banDangDung}/${db.ban.length}`;
  document.getElementById('stat-sp').textContent=db.sanpham.length;
  document.getElementById('stat-nv').textContent=db.nhanvien.filter(n=>n.TrangThai).length;
 
  const hdbRows=db.hoadonbanhang.slice(-5).reverse().map(h=>`
    <tr>
      <td><span style="font-family:'Space Mono',monospace;font-size:12px;color:var(--accent)">${h.MaHDBH}</span></td>
