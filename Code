function renderBan(filterKV='') {
  const grid=document.getElementById('ban-grid');
  const list=filterKV ? db.ban.filter(b=>b.MaKV===filterKV) : db.ban;
  grid.innerHTML=list.map(b=>`
    <div class="table-card ${b.TrangThai?'available':'occupied'}" onclick="toggleBan('${b.MaBan}')">
      <div class="table-num">${b.MaBan}</div>
      <div style="font-size:11px;color:var(--text3);margin-bottom:6px">${getKV(b.MaKV)}</div>
      <div class="badge ${b.TrangThai?'badge-green':'badge-red'}" style="justify-content:center">
        <span class="dot ${b.TrangThai?'dot-green':'dot-red'}"></span>
        ${b.TrangThai?'Trống':'Đang dùng'}
      </div>
    </div>`).join('');
 
  // Populate filter
  const sel=document.querySelector('#page-ban select');
  if(sel&&sel.children.length<=1) {
    db.khuvuc.forEach(k=>{ const o=document.createElement('option'); o.value=k.MaKV; o.textContent=k.TenKV; sel.appendChild(o); });
  }
 
  const busy=db.ban.filter(b=>!b.TrangThai).length;
  document.getElementById('badge-ban').textContent=busy;
  document.getElementById('stat-ban').textContent=`${busy}/${db.ban.length}`;
}
 
