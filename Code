  if(!id||!ten){alert('Vui lòng điền đầy đủ');return;}
  db.khuvuc.push({MaKV:id,TenKV:ten,TrangThai:tt});
  closeModal('modal-kv'); renderKV(); showToast('Đã thêm khu vực '+ten);
}
function saveLP() {
  const id=document.getElementById('lp-id').value.trim();
  const ten=document.getElementById('lp-ten').value.trim();
  if(!id||!ten){alert('Vui lòng điền đầy đủ');return;}
  db.loaiphieu.push({MaLP:id,TenLP:ten});
  closeModal('modal-lp'); renderLP(); showToast('Đã thêm '+ten);
}
 
function deleteItem(table, key, val, renderFn) {
  if(!confirm('Xác nhận xoá?')) return;
  db[table]=db[table].filter(x=>x[key]!==val);
  eval(renderFn+'()');
  showToast('Đã xoá!');
}
 
// ========== CLOCK ==========
function updateClock() {
  const now=new Date();
  document.getElementById('clock').textContent=now.toLocaleTimeString('vi-VN');
}
setInterval(updateClock,1000); updateClock();
 
// ========== INIT ==========
renderDashboard();
</script>
