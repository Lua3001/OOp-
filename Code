// ========== HELPERS ==========
const fmt = n => n?.toLocaleString('vi-VN') + 'đ';
const fmtNum = n => n?.toLocaleString('vi-VN');
 
function tinhThanhTien(maSP, sl) {
  const sp = db.sanpham.find(s => s.MaSP === maSP);
  return sp ? sp.DonGia * sl : 0;
}
function tinhTongHDB(maHDB) {
  return db.chitiethoadon.filter(ct => ct.MaHDBH === maHDB)
    .reduce((s,ct) => s + tinhThanhTien(ct.MaSP, ct.SL), 0);
}
function getNV(id) { const nv=db.nhanvien.find(n=>n.MaNV===id); return nv?nv.Ho+' '+nv.Ten:id; }
function getSP(id) { const sp=db.sanpham.find(s=>s.MaSP===id); return sp?sp.TenSP:id; }
function getNhom(id) { const n=db.nhomsp.find(x=>x.MaNhomSP===id); return n?n.TenNhomSP:id; }
function getKV(id) { const k=db.khuvuc.find(x=>x.MaKV===id); return k?k.TenKV:id; }
function getPQ(id) { const p=db.phanquyen.find(x=>x.MaPQ===id); return p?p.TenQuyen:id; }
function getNCC(id) { const n=db.nhacungcap.find(x=>x.MaNCC===id); return n?n.TenNCC:id; }
 
function showToast(msg='Đã lưu thành công!') {
  const t=document.getElementById('toast');
  document.getElementById('toast-msg').textContent=msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2500);
}
 
function openModal(id) {
  populateSelects();
  document.getElementById(id).classList.add('open');
}
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
 
document.querySelectorAll('.modal-overlay').forEach(m=>{
  m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('open'); });
});
 
function populateSelects() {
  // KV select
  const kvSel=document.getElementById('ban-kv');
  if(kvSel){ kvSel.innerHTML=db.khuvuc.map(k=>`<option value="${k.MaKV}">${k.TenKV}</option>`).join(''); }
  // Nhom SP
  const nhomSel=document.getElementById('sp-nhom');
  if(nhomSel){ nhomSel.innerHTML=db.nhomsp.map(n=>`<option value="${n.MaNhomSP}">${n.TenNhomSP}</option>`).join(''); }
  // NV
  ['hdnh-nv','hdb-nv','cc-nv'].forEach(id=>{
    const s=document.getElementById(id);
    if(s) s.innerHTML=db.nhanvien.map(n=>`<option value="${n.MaNV}">${n.Ho} ${n.Ten}</option>`).join('');
  });
  // NCC
  const nccSel=document.getElementById('hdnh-ncc');
  if(nccSel){ nccSel.innerHTML=db.nhacungcap.map(n=>`<option value="${n.MaNCC}">${n.TenNCC}</option>`).join(''); }
  // Ban
  const banSel=document.getElementById('hdb-ban');
  if(banSel){ banSel.innerHTML=db.ban.map(b=>`<option value="${b.MaBan}">${b.MaBan} (${getKV(b.MaKV)})</option>`).join(''); }
  // PQ
  const pqSel=document.getElementById('nv-pq');
  if(pqSel){ pqSel.innerHTML=db.phanquyen.map(p=>`<option value="${p.MaPQ}">${p.TenQuyen}</option>`).join(''); }
  // HDB
  const hdbSel=document.getElementById('ctbh-hdb');
  if(hdbSel){ hdbSel.innerHTML=db.hoadonbanhang.map(h=>`<option value="${h.MaHDBH}">${h.MaHDBH}</option>`).join(''); }
  // SP
  const spSel=document.getElementById('ctbh-sp');
  if(spSel){ spSel.innerHTML=db.sanpham.map(s=>`<option value="${s.MaSP}">${s.TenSP}</option>`).join(''); }
}
 
function filterTable(tableId, val) {
  const rows=document.querySelectorAll(`#${tableId} tbody tr`);
  const v=val.toLowerCase();
  rows.forEach(r=>{r.style.display=r.textContent.toLowerCase().includes(v)?'':'none';});
}
 
function filterBan(kv) { renderBan(kv); }
 
// ========== NAVIGATE ==========
function navigate(page, el) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById('page-'+page).classList.add('active');
  if(el) el.classList.add('active');
  document.getElementById('topbar-title').textContent = el?.textContent.trim() || page;
  renderPage(page);
}
 
function renderPage(p) {
  if(p==='dashboard') renderDashboard();
  else if(p==='ban') renderBan();
  else if(p==='hoadonbanhang') renderHDB();
  else if(p==='chitiethoadon') renderCTBH();
  else if(p==='nhomsp') renderNhomSP();
  else if(p==='sanpham') renderSP();
  else if(p==='nguyenlieu') renderNL();
  else if(p==='nhacungcap') renderNCC();
  else if(p==='hoadonnhaphang') renderHDNH();
  else if(p==='nhanvien') renderNV();
  else if(p==='chamcong') renderCC();
  else if(p==='phanquyen') renderPQ();
  else if(p==='khuvuc') renderKV();
  else if(p==='loaiphieu') renderLP();
}
 
